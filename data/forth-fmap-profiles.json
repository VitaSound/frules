{
  "_meta": {
    "schema": "forth-fmap-profiles/v1",
    "description": "Machine-readable Forth system profiles for dataset conditioning and retrieval. Human-readable guide: docs/FORTH-SYSTEM-ARCHITECTURE.md. Threading axis ex_c: docs/FORTH-THREADING.md, data/forth-threading-models.json",
    "axis_codes": {
      "mm": {
        "U": "unified address space",
        "S": "split Flash code + RAM data",
        "D": "dual dictionary (RAM + NVM Flash)",
        "F": "frozen ROM image",
        "V": "Forth-native / stack CPU ISA"
      },
      "ex_o": {
        "I": "interpret-only boot",
        "C": "compile-only",
        "M": "mixed STATE"
      },
      "ex_c": {
        "I": "ITC indirect threaded",
        "D": "DTC direct threaded",
        "S": "STC subroutine threaded",
        "N": "native machine code",
        "V": "CPU executes Forth opcodes",
        "B": "bytecode VM"
      },
      "ex_p": {
        "A": "primitives in asm",
        "V": "via NEXT inner loop",
        "S": "subroutine entry",
        "G": "generated (dynasm etc.)"
      },
      "rp": {
        "0": "execute-only, no REPL",
        "1": "autostart product, no field compile",
        "2": "REPL, read-only dict",
        "3": "REPL, compile to RAM",
        "4": "REPL, compile to Flash/NVM",
        "5": "full meta (FORGET, vocabs)"
      },
      "cg": {
        "E": "external assembler/toolchain",
        "F": "Forth-assembler on host",
        "I": "Forth source is ISA",
        "M": "mixed"
      },
      "bm": {
        "T": "toolchain to image",
        "C": "Forth cross-compiler",
        "N": "native self-rebuild",
        "H": "hybrid"
      },
      "kp": {
        "M": "minimal ~31 primitives",
        "S": "slim kernel",
        "R": "rich asm kernel",
        "V": "CPU-native"
      },
      "nc": {
        "0": "colon words threaded only",
        "1": "CODE words only",
        "2": "peephole optimization",
        "3": "colon to native"
      },
      "class": {
        "0": "Forth-native silicon / soft CPU",
        "1": "Harvard 8/16-bit MCU",
        "2": "retro unified/split 64K",
        "3": "32-bit MCU",
        "4": "desktop / hosted"
      },
      "status": {
        "active": "maintained or widely used",
        "legacy": "historical / niche",
        "archive": "defunct or reference only"
      }
    }
  },
